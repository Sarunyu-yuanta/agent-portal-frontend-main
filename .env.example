# Copy to .env.local and adjust. Every variable is optional in mock mode.

# mock — serve every endpoint from the bundled data in src/mocks (default)
# http — call the backend for endpoints that have an `http` implementation;
#        the rest keep answering from mock, so endpoints can be wired one by one
NEXT_PUBLIC_API_MODE=mock

# Base URL of the backend (BFF). Required when NEXT_PUBLIC_API_MODE=http.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/v1
